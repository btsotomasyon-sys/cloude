<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#030818">

    <FrameLayout android:id="@+id/frame" android:layout_width="match_parent" android:layout_height="220dp" android:background="#000000">
        <androidx.media3.ui.PlayerView android:id="@+id/pv" android:layout_width="match_parent" android:layout_height="match_parent"
            app:use_controller="false" app:resize_mode="fit" app:show_buffering="never"/>
        <ProgressBar android:id="@+id/spin" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
            android:indeterminateTint="#12D8FF" android:visibility="gone"/>

        <FrameLayout android:id="@+id/overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:alpha="0">
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top"
                android:gravity="center_vertical" android:padding="6dp">
                <ImageButton android:id="@+id/back" android:layout_width="44dp" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" android:contentDescription="Geri"/>
                <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:paddingStart="6dp"/>
                <TextView android:id="@+id/live" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● CANLI" android:textColor="#FF5D6C" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" android:paddingEnd="8dp"/>
                <ImageButton android:id="@+id/ratio" android:layout_width="44dp" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_ratio" android:contentDescription="Görüntü oranı"/>
                <ImageButton android:id="@+id/settings" android:layout_width="44dp" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_settings" android:contentDescription="Ayarlar"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_vertical">
                <ImageButton android:id="@+id/prev" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_btn" android:src="@drawable/ic_prev" android:contentDescription="Önceki"/>
                <ImageButton android:id="@+id/play" android:layout_width="68dp" android:layout_height="68dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp" android:background="@drawable/circle_btn" android:src="@drawable/ic_pause" android:contentDescription="Oynat / Duraklat"/>
                <ImageButton android:id="@+id/next" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_btn" android:src="@drawable/ic_next" android:contentDescription="Sonraki"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="10dp">
                    <TextView android:id="@+id/pos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp"/>
                    <TextView android:id="@+id/dur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="12sp"/>
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                    <ImageButton android:id="@+id/fs" android:layout_width="44dp" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_fullscreen" android:contentDescription="Tam ekran"/>
                </LinearLayout>
                <SeekBar android:id="@+id/seek" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="2dp"/>
            </LinearLayout>
        </FrameLayout>

        <TextView android:id="@+id/seekL" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical|start" android:layout_marginStart="36dp" android:background="@drawable/bubble" android:padding="14dp" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:visibility="gone"/>
        <TextView android:id="@+id/seekR" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical|end" android:layout_marginEnd="36dp" android:background="@drawable/bubble" android:padding="14dp" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:visibility="gone"/>
        <TextView android:id="@+id/hud" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="56dp" android:background="@drawable/bubble" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="#FFFFFF" android:textSize="14sp" android:visibility="gone"/>
        <LinearLayout android:id="@+id/err" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:padding="20dp" android:visibility="gone">
            <TextView android:id="@+id/errMsg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center"/>
            <Button android:id="@+id/retry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yeniden dene" android:textAllCaps="false"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:id="@+id/below" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/title2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EEF1FA" android:textSize="17sp" android:textStyle="bold"/>
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#8A94B2" android:textSize="12sp" android:paddingTop="2dp" android:paddingBottom="10dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sıradakiler" android:textColor="#EEF1FA" android:textSize="14sp" android:textStyle="bold" android:paddingBottom="6dp"/>
        <ListView android:id="@+id/nextList" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="#262E4A" android:dividerHeight="1px"/>
    </LinearLayout>
</LinearLayout>
